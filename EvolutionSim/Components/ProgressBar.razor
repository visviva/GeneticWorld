<div class="generation-progress">
    <div class="progress-meta">
        <span>@Label</span>
        <strong>@Progress.ToString("D2")%</strong>
    </div>
    <div class="progress-track" role="progressbar" aria-label="@Label" aria-valuenow="@Progress" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-value" style="width: @Progress%">
            <span></span>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public int Progress { get; set; }
}
