@inherits LayoutComponentBase

<FluentDesignTheme Mode="DesignThemeModes.Dark" CustomColor="#4bf3bc">
<div class="page-shell">
    <header class="site-header">
        <NavLink class="brand" href="" Match="NavLinkMatch.All" aria-label="Genetic World home">
            <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
            <span>Genetic World</span>
        </NavLink>

        <nav aria-label="Primary navigation">
            <NavLink href="" Match="NavLinkMatch.All">Observatory</NavLink>
            <NavLink href="about">About</NavLink>
            <a href="https://github.com/visviva/GeneticWorld" target="_blank" rel="noopener noreferrer">Source <span aria-hidden="true">↗</span></a>
        </nav>
    </header>

    <main class="content">
        @Body
    </main>

    <footer class="site-footer">
        <span>Genetic World</span>
        <span>Neural evolution, rendered live.</span>
    </footer>
</div>
</FluentDesignTheme>
